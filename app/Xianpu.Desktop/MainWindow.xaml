<Window x:Class="Xianpu.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Xianpu.Desktop"
        Title="弦笺 · StringNote · 吉他歌词和弦记谱" Height="920" Width="1380"
        MinHeight="680" MinWidth="980" WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" Drop="Window_Drop"
        Background="#F3F5F8" FontFamily="Microsoft YaHei UI" Foreground="#1E293B">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2F6B48" />
        <SolidColorBrush x:Key="AccentHover" Color="#245538" />
        <SolidColorBrush x:Key="AccentLight" Color="#EAF3ED" />
        <SolidColorBrush x:Key="BorderBrushStd" Color="#CBD5E1" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F6B48" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2F6B48" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#245538" />
                    <Setter Property="BorderBrush" Value="#245538" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EAF3ED" />
            <Setter Property="Foreground" Value="#245538" />
            <Setter Property="BorderBrush" Value="#94BFA4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCECE1" />
                    <Setter Property="BorderBrush" Value="#2F6B48" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChordChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#245538" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Primary Header (4 Metadata Fields + Core Actions) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,10">
            <DockPanel LastChildFill="True">
                <!-- Right Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="导入 LRC" Style="{StaticResource AccentOutlineButton}" Click="ImportLrc_Click" Margin="0,0,7,0" ToolTip="导入 .lrc 或 .txt 歌词文件（也支持直接拖入窗口）" />
                    <Button Content="编辑歌词" Click="EditAllLyrics_Click" Margin="0,0,7,0" ToolTip="粘贴或批量修改整首歌词（保留已有和弦）" />
                    <Button Content="清空新谱" Click="NewSong_Click" Margin="0,0,10,0" ToolTip="新建空白曲谱" />
                    <Border Width="1" Height="22" Background="#E2E8F0" Margin="0,0,10,0" />
                    <Button Content="打开" Click="OpenProject_Click" Margin="0,0,6,0" ToolTip="打开 .xianpu.json 曲谱文件" />
                    <Button Content="保存" Click="SaveToLibrary_Click" Margin="0,0,6,0" ToolTip="保存到本地曲库" />
                    <Button Content="导出项目" Click="SaveProject_Click" Margin="0,0,6,0" ToolTip="导出为 .xianpu.json 曲谱文件" />
                    <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Margin="0,0,10,0" ToolTip="检查 GitHub 最新版本 (当前 v1.0.0)" />
                    <Button Content="导出图片 (PNG)" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="ExportPng_Click" ToolTip="将当前曲谱导出为高清 PNG 图片" />
                </StackPanel>

                <!-- Brand + Library Toggle + 4 Strictly Scoped Song Metadata Fields -->
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#2F6B48" Margin="0,0,8,0">
                            <TextBlock Text="笺" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="弦笺" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                        <ToggleButton x:Name="LibraryToggle" Content="曲库 (0)" IsChecked="True"
                                      Margin="10,0,0,0" Padding="9,4" FontSize="12" FontWeight="SemiBold"
                                      Background="#EAF3ED" Foreground="#245538" BorderBrush="#94BFA4" BorderThickness="1" Cursor="Hand"
                                      Checked="LibraryToggle_Changed" Unchecked="LibraryToggle_Changed"
                                      ToolTip="展开或收起左侧本地曲库管理面板" />
                    </StackPanel>

                    <!-- 1. 歌曲名称 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                        <TextBlock Text="歌曲名称" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="TitleBox" Width="185" TextChanged="SongField_TextChanged" ToolTip="输入歌曲名称" />
                    </StackPanel>

                    <!-- 2. 原调 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                        <TextBlock Text="原调" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <ComboBox x:Name="OriginalKeyBox" Width="74" IsEditable="True"
                                  SelectionChanged="OriginalKeyBox_SelectionChanged"
                                  TextBoxBase.TextChanged="OriginalKeyBox_TextChanged"
                                  LostFocus="KeyBox_LostFocus" />
                    </StackPanel>

                    <!-- 3. 选调 + 一键升降调 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                        <TextBlock Text="选调" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <ComboBox x:Name="SelectedKeyBox" Width="74" IsEditable="True"
                                  SelectionChanged="SelectedKeyBox_SelectionChanged"
                                  TextBoxBase.TextChanged="SelectedKeyBox_TextChanged"
                                  LostFocus="KeyBox_LostFocus" />
                        <Button Content="♭-1" Padding="6,4" Margin="4,0,2,0" FontSize="11.5" Click="TransposeDown_Click" ToolTip="全谱和弦降半音" />
                        <Button Content="♯+1" Padding="6,4" Margin="0,0,2,0" FontSize="11.5" Click="TransposeUp_Click" ToolTip="全谱和弦升半音" />
                        <Button Content="移调" Padding="7,4" FontSize="11.5" Click="TransposeDialog_Click" ToolTip="指定原和弦调与目标调批量转换和弦" />
                    </StackPanel>

                    <!-- 4. 变调夹 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,6,2">
                        <TextBlock Text="变调夹" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <ComboBox x:Name="CapoBox" Width="86" IsEditable="True"
                                  SelectionChanged="CapoBox_SelectionChanged"
                                  TextBoxBase.TextChanged="CapoBox_TextChanged"
                                  LostFocus="KeyBox_LostFocus"
                                  ToolTip="例如：不夹、2 品、4 品" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: Secondary Bar (Diatonic Left-Hand Chord Quick Bar + Layout/Display Options) -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="18,7">
            <DockPanel LastChildFill="True">
                <!-- Right Layout & Display Controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="RemoveChordButton" Content="删除选中和弦" Padding="9,4" FontSize="12" Click="RemoveChord_Click" IsEnabled="False" Margin="0,0,6,0" ToolTip="删除当前选中的和弦 (Delete / Backspace)" />
                    <Button Content="清空和弦" Padding="9,4" FontSize="12" Click="ClearAllChords_Click" Margin="0,0,10,0" ToolTip="清除整首歌上的所有和弦标记" />
                    <Border Width="1" Height="18" Background="#CBD5E1" Margin="0,0,10,0" />

                    <TextBlock Text="排版" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox x:Name="ColumnModeBox" Width="96" SelectedValuePath="Tag" SelectionChanged="ColumnMode_Changed" Margin="0,0,10,0" ToolTip="合行紧凑：从头到尾顺序排布，自动把 2~3 句短歌词放在同一行内；逐句单行：每句占一行">
                        <ComboBoxItem Content="合行紧凑" Tag="0" />
                        <ComboBoxItem Content="逐句单行" Tag="1" />
                        <ComboBoxItem Content="双栏对照" Tag="2" />
                    </ComboBox>

                    <TextBlock Text="标记" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <ComboBox x:Name="ChordDisplayBox" Width="88" SelectedValuePath="Tag" SelectionChanged="ChordDisplay_Changed" ToolTip="切换歌词上方显示和弦名称、六弦指法图或级数">
                        <ComboBoxItem Content="和弦名称" Tag="name" />
                        <ComboBoxItem Content="指法图" Tag="diagram" />
                        <ComboBoxItem Content="级数" Tag="degree" />
                    </ComboBox>
                </StackPanel>

                <!-- Left: Common Chords in Current Selected Key + Continuous Paint Mode -->
                <WrapPanel VerticalAlignment="Center">
                    <ToggleButton x:Name="ContinuousPaintToggle" Content="✎ 连点填谱" Padding="9,4" Margin="0,0,8,0" FontSize="12"
                                  Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" Cursor="Hand"
                                  Checked="ContinuousPaint_Changed" Unchecked="ContinuousPaint_Changed"
                                  ToolTip="开启后：先点选下方一个常用和弦，再连续点击歌词上的进唱字位即可批量放置该和弦" />
                    <TextBlock x:Name="PaletteKeyLabel" Text="常用左手和弦：" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <WrapPanel x:Name="QuickChordPanel" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="提示：直接点击歌词上的「进唱字位」即可输入或点选左手和弦；方向键可左右移动字位。"
                               FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Row 2: Collapsible Song Library Drawer + Score Canvas -->
        <Grid Grid.Row="2" Background="#E6EBF1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Collapsible Local Song Library Drawer -->
            <Border x:Name="LibraryDrawer" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <Grid Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,9">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="本地曲库" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                            <Border Background="#EAF3ED" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LibraryCountText" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="#245538" />
                            </Border>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ 新建" Padding="7,3" FontSize="11.5" Margin="0,0,4,0" Click="NewSong_Click" ToolTip="新建空白曲谱并加入曲库" />
                            <Button Content="保存" Padding="7,3" FontSize="11.5" Margin="0,0,4,0" Style="{StaticResource AccentOutlineButton}" Click="SaveToLibrary_Click" ToolTip="保存当前曲谱到本地曲库" />
                            <Button Content="副本" Padding="7,3" FontSize="11.5" Click="DuplicateSong_Click" ToolTip="复制当前曲谱为新副本" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Search Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBox x:Name="LibrarySearchBox" Padding="8,5" FontSize="12.5"
                                 TextChanged="LibraryFilter_Changed"
                                 ToolTip="搜索歌名、调号、分类或歌词..." />
                        <TextBlock x:Name="LibrarySearchPlaceholder" Text="搜索歌名、调号、分类或歌词..."
                                   FontSize="12" Foreground="#94A3B8" Margin="10,0,8,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <!-- Filter Row -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LibraryAllFilterButton" Grid.Column="0" Content="全部" Padding="8,3" FontSize="11.5" Margin="0,0,4,0" Click="LibraryAllFilter_Click" />
                        <Button x:Name="LibraryFavFilterButton" Grid.Column="1" Content="★ 收藏" Padding="8,3" FontSize="11.5" Margin="0,0,5,0" Click="LibraryFavFilter_Click" />
                        <ComboBox x:Name="LibraryCategoryFilter" Grid.Column="2" FontSize="11.5" Padding="6,3" SelectionChanged="LibraryFilter_Changed" ToolTip="按分类筛选曲库" />
                        <Button Grid.Column="3" Content="+ 分类" Padding="7,3" FontSize="11.5" Margin="4,0,0,0" Click="AddCategory_Click" ToolTip="添加新曲库分类" />
                    </Grid>

                    <!-- Active Song Quick Meta -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <DockPanel>
                            <ToggleButton x:Name="SongFavoriteToggle" DockPanel.Dock="Right" Content="☆ 收藏"
                                          Padding="8,3" FontSize="11.5" Margin="6,0,0,0"
                                          Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" Cursor="Hand"
                                          Checked="SongFavoriteToggle_Changed" Unchecked="SongFavoriteToggle_Changed"
                                          ToolTip="标记或取消收藏当前曲谱" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="分类" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="SongCategoryBox" Width="116" IsEditable="True" FontSize="12" Padding="6,3"
                                          SelectionChanged="SongCategoryBox_SelectionChanged"
                                          LostFocus="SongCategoryBox_LostFocus"
                                          PreviewKeyDown="SongCategoryBox_PreviewKeyDown"
                                          ToolTip="选择或输入当前曲谱分类" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Song List -->
                    <ListBox x:Name="LibrarySongList" Grid.Row="4"
                             BorderBrush="#E2E8F0" BorderThickness="1" Background="#FFFFFF"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="LibrarySongList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="Margin" Value="2,1" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#F1F5F9" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <TextBlock DockPanel.Dock="Right" Text="★" FontSize="12" Foreground="#D97706" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <DockPanel Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}" FontSize="10.5" Foreground="#94A3B8" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding ListSummary}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom Action Bar -->
                    <UniformGrid Grid.Row="5" Columns="4" Margin="0,8,0,0">
                        <Button x:Name="ListFavoriteButton" Content="★ 收藏" Padding="4,4" FontSize="11" Margin="0,0,4,0" Click="ToggleSelectedFavorite_Click" ToolTip="切换当前曲谱收藏状态" />
                        <Button Content="重命名" Padding="4,4" FontSize="11" Margin="0,0,4,0" Click="RenameSong_Click" ToolTip="重命名当前曲谱" />
                        <Button Content="改词" Padding="4,4" FontSize="11" Margin="0,0,4,0" Click="EditAllLyrics_Click" ToolTip="批量编辑当前曲谱歌词" />
                        <Button Content="删除" Padding="4,4" FontSize="11" Foreground="#B91C1C" BorderBrush="#FECACA" Background="#FEF2F2" Click="DeleteSong_Click" ToolTip="从本地曲库删除当前曲谱" />
                    </UniformGrid>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ScoreScrollViewer" Grid.Column="1" SizeChanged="ScoreViewport_SizeChanged"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="Transparent" Padding="18">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"
                        Margin="4" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.08" Color="#0F172A" />
                    </Border.Effect>
                    <local:ScoreSurface x:Name="ScoreSurface" />
                </Border>
            </ScrollViewer>

            <!-- Inline Chord Input & Quick-Pick Popover (Anchored directly above the clicked lyric character) -->
            <Popup x:Name="ChordPopover" Grid.Column="1" PlacementTarget="{Binding ElementName=ScoreSurface}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   Closed="ChordPopover_Closed">
                <Border Background="#FFFFFF" BorderBrush="#2F6B48" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Margin="10" Width="408">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" Color="#0F172A" />
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border Background="#EAF3ED" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock x:Name="PopoverTargetLabel" Text="进唱字位和弦" FontSize="11.5" FontWeight="SemiBold" Foreground="#2F6B48" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="Enter 确定 · Tab 下一字" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,0,0,8">
                            <ScrollViewer x:Name="PopoverCharStripScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PopoverCharStrip" Orientation="Horizontal" />
                            </ScrollViewer>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="位置：" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="PosOnCharRadio" Content="在字上" GroupName="ChordPosGroup" IsChecked="True"
                                                 FontSize="11.5" VerticalAlignment="Center" Padding="6,2" Margin="0,0,4,0" Cursor="Hand"
                                                 Checked="PopoverPosition_Changed" />
                                    <RadioButton x:Name="PosBeforeCharRadio" Content="在字前" GroupName="ChordPosGroup"
                                                 FontSize="11.5" VerticalAlignment="Center" Padding="6,2" Cursor="Hand"
                                                 Checked="PopoverPosition_Changed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InlineChordBox" Grid.Column="0" FontSize="14" FontWeight="Bold" Padding="9,5"
                                     PreviewKeyDown="InlineChordBox_PreviewKeyDown"
                                     ToolTip="直接输入任意左手和弦名称，例如 C、Am7、Fmaj7、G/B、Bm7-5、Cadd9" />
                            <Button Grid.Column="1" Content="确定" Style="{StaticResource PrimaryButton}" Padding="11,5" Margin="6,0,0,0" Click="CommitInlineChord_Click" />
                            <Button x:Name="DeleteInlineChordButton" Grid.Column="2" Content="删除" Padding="9,5" Margin="5,0,0,0" Foreground="#B91C1C" BorderBrush="#FECACA" Background="#FEF2F2" Click="DeleteInlineChord_Click" />
                        </Grid>
                        <TextBlock Text="本调常用和弦（单击直接填入）：" FontSize="10.5" Foreground="#64748B" Margin="0,0,0,5" />
                        <WrapPanel x:Name="PopoverChordWrap" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>
