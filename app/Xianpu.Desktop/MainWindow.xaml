<Window x:Class="Xianpu.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Xianpu.Desktop"
        Title="弦笺 · StringNote · 吉他歌词和弦记谱" Height="740" Width="1200"
        MinHeight="500" MinWidth="740" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" Drop="Window_Drop"
        Background="#EEF1F4" FontFamily="Microsoft YaHei UI" Foreground="#1E293B">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TopBarGhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF2F6" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChordChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,1,4,1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F8FAF8" />
            <Setter Property="Foreground" Value="#245538" />
            <Setter Property="BorderBrush" Value="#DCE5DF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF3ED" />
                    <Setter Property="BorderBrush" Value="#94BFA4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptionControlButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EEF2F6" />
                                <Setter Property="Foreground" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C50F1F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineTitleBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#94BFA4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetaPillTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,1" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowOuterBorder" BorderBrush="#CBD5E1" BorderThickness="1" Background="#EEF1F4">
        <Grid x:Name="RootLayoutGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Unified Single-Row Studio Top Bar (44px, Draggable Caption + All Core Global Commands) -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand + Library Toggle + Import Dropdown + Undo/Redo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="LibraryToggle" IsChecked="True"
                                      WindowChrome.IsHitTestVisibleInChrome="True"
                                      Padding="8,4" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold"
                                      Checked="LibraryToggle_Changed" Unchecked="LibraryToggle_Changed"
                                      ToolTip="展开或收起左侧本地曲库">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/logo64.png" Width="18" Height="18" Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding LibraryToggleText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Border Width="1" Height="18" Background="#E2E8F0" Margin="2,0,6,0" />

                        <Button x:Name="ImportMenuButton" Content="+ 导入 ▾" Style="{StaticResource AccentOutlineButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Padding="10,4" Margin="0,0,4,0" Click="ImportMenu_Click"
                                ToolTip="导入 LRC/文本、AI 识谱导入、导入好友谱子或新建空白曲谱" />

                        <Button x:Name="UndoButton" Content="↩" Style="{StaticResource TopBarGhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Padding="7,4" Margin="0,0,2,0" FontSize="13"
                                Command="{Binding UndoCommand}" ToolTip="{Binding UndoToolTip}" />
                        <Button x:Name="RedoButton" Content="↪" Style="{StaticResource TopBarGhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Padding="7,4" Margin="0,0,4,0" FontSize="13"
                                Command="{Binding RedoCommand}" ToolTip="{Binding RedoToolTip}" />

                        <TextBlock x:Name="CaptionSongTitle" Text="{Binding CaptionSongTitle}"
                                   FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"
                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </StackPanel>

                    <!-- Center: Edit Mode vs Practice Mode Segmented Pill -->
                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="3" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="EditModeButton" Content="✎ 编辑制谱" Padding="11,4" FontSize="11.5" FontWeight="SemiBold"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Background="#FFFFFF" BorderBrush="Transparent" Foreground="#1E293B"
                                    Command="{Binding EnterEditModeCommand}" ToolTip="编辑模式：显示曲库与悬浮和弦条（F5 切换）" />
                            <Button x:Name="PracticeModeButton" Content="🎸 练琴看谱" Padding="11,4" FontSize="11.5"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Background="Transparent" BorderBrush="Transparent" Foreground="#64748B"
                                    Command="{Binding EnterPracticeModeCommand}" ToolTip="练琴专注模式：隐藏编辑栏，放大谱面视野并浮出滚屏/节拍器（F5 切换）" />
                        </StackPanel>
                    </Border>

                    <!-- Right: Arrange Menu + Save + Export Menu + Settings + Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="PartArrangeButton" Content="编排 ▾" Style="{StaticResource TopBarGhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Margin="0,0,2,0" Click="ArrangeMenu_Click"
                                ToolTip="编辑歌词、段落编排与叠行、排版模式、和弦操作" />
                        <Button Content="保存" Style="{StaticResource TopBarGhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Margin="0,0,4,0" Click="SaveToLibrary_Click" ToolTip="保存当前曲谱到本地曲库" />
                        <Button x:Name="ExportMenuButton" Content="导出 ▾" Style="{StaticResource PrimaryButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Padding="11,4" Margin="0,0,6,0" Click="ExportMenu_Click"
                                ToolTip="导出高清 PNG、A4 打印/PDF 或 .xianpu.json 分享" />

                        <Border Width="1" Height="18" Background="#E2E8F0" Margin="0,0,4,0" />

                        <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource TopBarGhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Padding="7,4" FontSize="13.5" Margin="0,0,1,0" Click="Settings_Click"
                                ToolTip="设置与曲库备份（自定义数据路径 / 自动快照 / 整库恢复）" />
                        <Button x:Name="CheckUpdateButton" Content="↻" Style="{StaticResource TopBarGhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Padding="7,4" FontSize="13" Margin="0,0,4,0" Click="CheckUpdate_Click"
                                ToolTip="检查 GitHub 最新版本" />

                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionControlButton}" Click="MinimizeWindow_Click" ToolTip="最小化">
                            <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionControlButton}" Click="ToggleMaximize_Click" ToolTip="全屏 / 最大化">
                            <Path x:Name="MaximizeIconPath" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                        <Button x:Name="ExitButton" Style="{StaticResource CaptionCloseButton}" Click="ExitWindow_Click" ToolTip="退出">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Two-Pane Studio Workspace (Light Notion-Style Sidebar + Airy Canvas Stage) -->
            <Grid Grid.Row="1" Background="#EEF1F4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LibraryColumn" Width="236" MinWidth="170" MaxWidth="420" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Collapsible Local Song Library Drawer -->
                <Border x:Name="LibraryDrawer" Grid.Column="0" Background="#F8F9FA" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                    <Grid Margin="10,10,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drawer Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="本地曲库" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                <Border Background="#EAF3ED" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LibraryCountText" Text="{Binding FilteredCountDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#245538" />
                                </Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ 新建" Padding="7,3" FontSize="11" Margin="0,0,4,0" Click="NewSong_Click" ToolTip="新建空白曲谱并加入曲库" />
                                <Button Content="副本" Padding="7,3" FontSize="11" Click="DuplicateSong_Click" ToolTip="复制当前曲谱为新副本" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Search Box -->
                        <Grid Grid.Row="1" Margin="0,0,0,7">
                            <TextBox x:Name="LibrarySearchBox" Padding="8,5" FontSize="12"
                                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="搜索歌名、原唱、调号、分类或歌词..." />
                            <TextBlock x:Name="LibrarySearchPlaceholder" Text="搜索歌名、原唱、调号或歌词..."
                                       FontSize="11.5" Foreground="#94A3B8" Margin="10,0,8,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Filter Row -->
                        <Grid Grid.Row="2" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LibraryAllFilterButton" Grid.Column="0" Content="全部" Padding="7,3" FontSize="11" Margin="0,0,4,0" Command="{Binding ShowAllSongsCommand}" />
                            <Button x:Name="LibraryFavFilterButton" Grid.Column="1" Content="★ 收藏" Padding="7,3" FontSize="11" Margin="0,0,4,0" Command="{Binding ShowFavoriteSongsCommand}" />
                            <ComboBox x:Name="LibraryCategoryFilter" Grid.Column="2" FontSize="11" Padding="5,2" SelectionChanged="LibraryFilter_Changed" ToolTip="按分类筛选曲库" />
                            <Button Grid.Column="3" Content="+" Padding="6,3" FontSize="11" Margin="4,0,0,0" Command="{Binding AddCategoryCommand}" ToolTip="添加新曲库分类" />
                        </Grid>

                        <!-- Active Song Category & Favorite -->
                        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E5EAF0" BorderThickness="1" CornerRadius="7" Padding="7,5" Margin="0,0,0,7">
                            <DockPanel>
                                <ToggleButton x:Name="SongFavoriteToggle" DockPanel.Dock="Right" Content="☆ 收藏"
                                              Padding="7,2" FontSize="11" Margin="5,0,0,0"
                                              Checked="SongFavoriteToggle_Changed" Unchecked="SongFavoriteToggle_Changed"
                                              ToolTip="标记或取消收藏当前曲谱" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="分类" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <ComboBox x:Name="SongCategoryBox" Width="100" IsEditable="True" FontSize="11.5" Padding="5,2"
                                              SelectionChanged="SongCategoryBox_SelectionChanged"
                                              LostFocus="SongCategoryBox_LostFocus"
                                              PreviewKeyDown="SongCategoryBox_PreviewKeyDown"
                                              ToolTip="选择或输入当前曲谱分类" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Song List -->
                        <ListBox x:Name="LibrarySongList" Grid.Row="4"
                                 ItemsSource="{Binding FilteredSongs}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LibrarySongList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,7" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Background" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#E8EDF2" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemCard" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemCard" Property="Background" Value="#F8FBF9" />
                                                        <Setter TargetName="ItemCard" Property="BorderBrush" Value="#C5DCCD" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemCard" Property="Background" Value="#EAF3ED" />
                                                        <Setter TargetName="ItemCard" Property="BorderBrush" Value="#2F6B48" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock DockPanel.Dock="Right" Text="★" FontSize="11.5" Foreground="#D97706" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DockPanel Grid.Row="1" Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}" FontSize="10" Foreground="#94A3B8" Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding ListSummary}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Bottom Song Actions -->
                        <UniformGrid Grid.Row="5" Columns="4" Margin="0,7,0,0">
                            <Button x:Name="ListFavoriteButton" Content="★ 收藏" Padding="3,4" FontSize="11" Margin="0,0,3,0" Command="{Binding ToggleFavoriteCommand}" ToolTip="切换当前曲谱收藏状态" />
                            <Button Content="重命名" Padding="3,4" FontSize="11" Margin="0,0,3,0" Command="{Binding RenameSelectedSongCommand}" ToolTip="重命名当前曲谱" />
                            <Button Content="改词" Padding="3,4" FontSize="11" Margin="0,0,3,0" Click="EditAllLyrics_Click" ToolTip="批量编辑当前曲谱歌词" />
                            <Button Content="删除" Padding="3,4" FontSize="11" Foreground="#B91C1C" BorderBrush="#FECACA" Background="#FEF2F2" Command="{Binding DeleteSelectedSongCommand}" ToolTip="从本地曲库删除当前曲谱" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Resizable Splitter -->
                <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                              Background="Transparent"
                              ToolTip="左右拖拽调整曲库与谱面宽度" />

                <!-- Right Studio Canvas Stage -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Floating Contextual Chord & Quick-Tool Bar (Auto-hidden in Practice Mode) -->
                    <Border x:Name="FloatingChordBar" Grid.Row="0" Margin="16,10,16,2" Padding="10,6"
                            Background="#FFFFFF" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="10"
                            HorizontalAlignment="Stretch" MaxWidth="1120">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#0F172A" />
                        </Border.Effect>
                        <WrapPanel VerticalAlignment="Center">
                            <ToggleButton x:Name="ContinuousPaintToggle" Content="✎ 连点" Padding="8,3" Margin="0,2,5,2" FontSize="11.5"
                                          Checked="ContinuousPaint_Changed" Unchecked="ContinuousPaint_Changed"
                                          ToolTip="开启后：点选一个常用和弦，再连续点击歌词字位批量放置" />
                            <ToggleButton x:Name="LyricEditModeToggle" Content="Ｉ 改词" Padding="8,3" Margin="0,2,6,2" FontSize="11.5"
                                          Checked="LyricEditMode_Changed" Unchecked="LyricEditMode_Changed"
                                          ToolTip="改词模式：开启后单击任意歌词即可直接在纸面上打字改词（默认模式下双击歌词或按 F2 也可原位改词）" />
                            <TextBlock x:Name="PaletteKeyLabel" Text="常用：" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,2,4,2" />
                            <WrapPanel x:Name="QuickChordPanel" VerticalAlignment="Center" />

                            <Border Width="1" Height="16" Background="#E2E8F0" Margin="6,2,6,2" />

                            <ComboBox x:Name="ColumnModeBox" Width="88" Height="26" Padding="8,2" SelectedValuePath="Tag" Margin="0,2,5,2" SelectionChanged="ColumnMode_Changed" ToolTip="排版模式：合行紧凑 / 逐句单行 / 双栏对照">
                                <ComboBoxItem Content="合行紧凑" Tag="0" />
                                <ComboBoxItem Content="逐句单行" Tag="1" />
                                <ComboBoxItem Content="双栏对照" Tag="2" />
                            </ComboBox>

                            <ComboBox x:Name="ChordDisplayBox" Width="78" Height="26" Padding="8,2" SelectedValuePath="Tag" Margin="0,2,5,2" SelectionChanged="ChordDisplay_Changed" ToolTip="切换显示和弦名称、六弦指法图或级数">
                                <ComboBoxItem Content="和弦名" Tag="name" />
                                <ComboBoxItem Content="指法图" Tag="diagram" />
                                <ComboBoxItem Content="级数" Tag="degree" />
                            </ComboBox>

                            <Button x:Name="ChordOpsMenuButton" Content="和弦 ▾" Padding="8,3" FontSize="11.5" Margin="0,2,5,2" Click="ChordOpsMenu_Click" ToolTip="复制/粘贴句和弦、删除选中和弦、清空全部和弦" />
                            <Button x:Name="TabSectionButton" Content="+ 六线谱" Style="{StaticResource AccentOutlineButton}"
                                    Padding="8,3" FontSize="11.5" Margin="0,2,0,2" Click="TabSectionMenu_Click"
                                    ToolTip="添加或管理前奏 / 间奏 / 尾奏六线谱（可选扩展组件）" />

                            <!-- Hidden compatibility buttons kept for existing UpdateActionStates references -->
                            <Button x:Name="CopyLineChordsButton" Visibility="Collapsed" Click="CopyLineChords_Click" />
                            <Button x:Name="PasteLineChordsButton" Visibility="Collapsed" Click="PasteLineChords_Click" />
                            <Button x:Name="RemoveChordButton" Visibility="Collapsed" Click="RemoveChord_Click" />
                        </WrapPanel>
                    </Border>

                    <!-- Score Viewport (Unified Paper Card: Inline Editable Header + ScoreSurface) -->
                    <ScrollViewer x:Name="ScoreScrollViewer" Grid.Row="1"
                                  SizeChanged="ScoreViewport_SizeChanged"
                                  PreviewMouseWheel="ScoreScrollViewer_PreviewMouseWheel"
                                  PreviewMouseDown="ScoreScrollViewer_PreviewMouseDown"
                                  PreviewMouseMove="ScoreScrollViewer_PreviewMouseMove"
                                  PreviewMouseUp="ScoreScrollViewer_PreviewMouseUp"
                                  LostMouseCapture="ScoreScrollViewer_LostMouseCapture"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent" Padding="16,10,16,24">
                        <Border x:Name="ScorePaperCard" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="10"
                                Margin="4" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.07" Color="#0F172A" />
                            </Border.Effect>
                            <StackPanel>
                                <!-- Notion-Style Inline Editable Sheet Header (Lives right on the paper!) -->
                                <Border x:Name="InlineSheetHeader" Padding="36,22,36,14" BorderBrush="#E5EAF0" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBox x:Name="TitleBox" Style="{StaticResource InlineTitleBoxStyle}"
                                                 Text="{Binding SelectedSong.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="直接点击修改歌曲名称" />

                                        <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                            <!-- 原唱 -->
                                            <Border Background="#F6F8F7" BorderBrush="#E2EAE5" BorderThickness="1" CornerRadius="14" Padding="9,3" Margin="3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="原唱" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBox x:Name="ArtistBox" Style="{StaticResource MetaPillTextBox}" MinWidth="48" MaxWidth="150"
                                                             Text="{Binding SelectedSong.Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             LostFocus="KeyBox_LostFocus"
                                                             ToolTip="可选填写原唱歌手（导入 LRC 时自动提取 [ar:] 标签）" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 原调 -->
                                            <Border Background="#F6F8F7" BorderBrush="#E2EAE5" BorderThickness="1" CornerRadius="14" Padding="9,2" Margin="3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="原调" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <ComboBox x:Name="OriginalKeyBox" Width="58" IsEditable="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold"
                                                              Text="{Binding SelectedSong.OriginalKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              LostFocus="KeyBox_LostFocus" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 选调 + 快捷移调 -->
                                            <Border Background="#F6F8F7" BorderBrush="#E2EAE5" BorderThickness="1" CornerRadius="14" Padding="9,2" Margin="3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="选调" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <ComboBox x:Name="SelectedKeyBox" Width="58" IsEditable="True" BorderThickness="0" Background="Transparent" FontWeight="Bold" Foreground="#245538"
                                                              Text="{Binding SelectedSong.SelectedKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              LostFocus="KeyBox_LostFocus" />
                                                    <StackPanel x:Name="InlineTransposeControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                                                        <Button Content="♭" Padding="5,1" FontSize="11" Margin="2,0,1,0" Click="TransposeDown_Click" ToolTip="全谱降半音 (♭-1)" />
                                                        <Button Content="♯" Padding="5,1" FontSize="11" Margin="1,0,2,0" Click="TransposeUp_Click" ToolTip="全谱升半音 (♯+1)" />
                                                        <Button Content="移调" Padding="6,1" FontSize="11" Click="TransposeDialog_Click" ToolTip="按原调与目标调批量移调" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- 变调夹 -->
                                            <Border Background="#F6F8F7" BorderBrush="#E2EAE5" BorderThickness="1" CornerRadius="14" Padding="9,2" Margin="3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="变调夹" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <ComboBox x:Name="CapoBox" Width="68" IsEditable="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold"
                                                              Text="{Binding SelectedSong.Capo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              LostFocus="KeyBox_LostFocus"
                                                              ToolTip="例如：不夹、2 品、4 品" />
                                                </StackPanel>
                                            </Border>

                                            <!-- BPM -->
                                            <Border Background="#F6F8F7" BorderBrush="#E2EAE5" BorderThickness="1" CornerRadius="14" Padding="9,3" Margin="3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="BPM" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBox x:Name="BpmBox" Style="{StaticResource MetaPillTextBox}" Width="38" HorizontalContentAlignment="Center"
                                                             Text="{Binding BpmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             LostFocus="BpmBox_LostFocus"
                                                             ToolTip="可选拍速（30~240），留空则导出时不显示；可配合底部节拍器使用" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Main Custom-Drawn Score Canvas + On-Paper Inline Lyric Overlay -->
                                <Grid>
                                    <local:ScoreSurface x:Name="ScoreSurface" />
                                    <Canvas x:Name="InlineLyricOverlayCanvas" Visibility="Collapsed" Panel.ZIndex="5">
                                        <StackPanel x:Name="InlineLyricEditorContainer">
                                            <Border x:Name="InlineLyricCard" Background="#FFFFFF" BorderBrush="#2F6B48" BorderThickness="1.5"
                                                    CornerRadius="6" Padding="5,2">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.14" Color="#0F172A" />
                                                </Border.Effect>
                                                <TextBox x:Name="InlineLyricBox"
                                                         FontFamily="Microsoft YaHei" FontSize="19" Foreground="#1E293B"
                                                         BorderThickness="0" Background="Transparent" Padding="1,0"
                                                         TextWrapping="Wrap" AcceptsReturn="False"
                                                         PreviewKeyDown="InlineLyricBox_PreviewKeyDown"
                                                         LostKeyboardFocus="InlineLyricBox_LostKeyboardFocus" />
                                            </Border>
                                            <Border Background="#F5FFFFFF" BorderBrush="#DCE5DF" BorderThickness="1" CornerRadius="5"
                                                    Padding="7,2" Margin="0,3,0,0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="InlineLyricBadgeText" Text="原位改词" FontSize="10.5" FontWeight="SemiBold" Foreground="#2F6B48" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock x:Name="InlineLyricHintText" Text="Enter 保存 · Shift+Enter 断句 · ↑↓ 切句 · Esc 取消" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" />
                                                    <Button x:Name="InlineAddAltButton" Content="+ 叠行" Padding="6,1" FontSize="10.5" Margin="8,0,0,0"
                                                            Style="{StaticResource AccentOutlineButton}" Focusable="False"
                                                            Click="InlineAddAlt_Click" ToolTip="在此句下方添加并原位编辑下一遍叠行歌词" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Canvas>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- Floating Practice Dock (Shown at bottom-center in Practice Mode) -->
                    <Border x:Name="PracticeFloatingDock" Grid.Row="1" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                            Background="#E61E293B" CornerRadius="22" Padding="14,7">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.24" Color="#0F172A" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎸 练琴专注模式" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="▶ 滚屏 / 暂停 (Space)" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11.5" Margin="0,0,8,0" Click="DockToggleScroll_Click" />
                            <Button Content="♩ 节拍器" Padding="10,4" FontSize="11.5" Margin="0,0,8,0" Click="DockToggleMetronome_Click" />
                            <Button Content="退出练琴" Padding="10,4" FontSize="11.5" Background="#334155" Foreground="#F8FAFC" BorderBrush="#475569" Command="{Binding EnterEditModeCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Inline Chord Input & Quick-Pick Popover -->
                    <Popup x:Name="ChordPopover" Grid.Row="1" PlacementTarget="{Binding ElementName=ScoreSurface}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           Closed="ChordPopover_Closed">
                        <Border Background="#FFFFFF" BorderBrush="#2F6B48" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Margin="10" Width="408">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" Color="#0F172A" />
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border Background="#EAF3ED" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="PopoverTargetLabel" Text="进唱字位和弦" FontSize="11.5" FontWeight="SemiBold" Foreground="#2F6B48" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="Enter 确定 · Tab 下一字" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,0,0,8">
                                    <ScrollViewer x:Name="PopoverCharStripScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="PopoverCharStrip" Orientation="Horizontal" />
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="位置：" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="PosOnCharRadio" Content="在字上" GroupName="ChordPosGroup" IsChecked="True"
                                                         FontSize="11.5" VerticalAlignment="Center" Padding="6,2" Margin="0,0,4,0" Cursor="Hand"
                                                         Checked="PopoverPosition_Changed" />
                                            <RadioButton x:Name="PosBeforeCharRadio" Content="在字前" GroupName="ChordPosGroup"
                                                         FontSize="11.5" VerticalAlignment="Center" Padding="6,2" Cursor="Hand"
                                                         Checked="PopoverPosition_Changed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InlineChordBox" Grid.Column="0" FontSize="14" FontWeight="Bold" Padding="9,5"
                                             PreviewKeyDown="InlineChordBox_PreviewKeyDown"
                                             ToolTip="直接输入任意左手和弦名称，例如 C、Am7、Fmaj7、G/B、Bm7-5、Cadd9" />
                                    <Button Grid.Column="1" Content="确定" Style="{StaticResource PrimaryButton}" Padding="11,5" Margin="6,0,0,0" Click="CommitInlineChord_Click" />
                                    <Button x:Name="DeleteInlineChordButton" Grid.Column="2" Content="删除" Padding="9,5" Margin="5,0,0,0" Foreground="#B91C1C" BorderBrush="#FECACA" Background="#FEF2F2" Click="DeleteInlineChord_Click" />
                                </Grid>
                                <TextBlock Text="本调常用和弦（单击直接填入）：" FontSize="10.5" Foreground="#64748B" Margin="0,0,0,5" />
                                <WrapPanel x:Name="PopoverChordWrap" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <!-- Row 2: Compact Quiet Bottom Status, Practice Controls & Zoom Bar -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,4">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <!-- Practice: Auto-Scroll -->
                        <ToggleButton x:Name="AutoScrollToggle" Content="{Binding Practice.AutoScrollButtonText}" Padding="7,2" FontSize="11" Margin="0,0,4,0"
                                      Checked="AutoScrollToggle_Changed" Unchecked="AutoScrollToggle_Changed"
                                      ToolTip="开启/暂停自动滚屏看谱（滚屏激活时按 Space 空格键可随时暂停/继续）" />
                        <ComboBox x:Name="AutoScrollSpeedBox" Width="54" FontSize="11" Padding="4,1" Margin="0,0,8,0"
                                  SelectedIndex="2" SelectedValuePath="Tag"
                                  ToolTip="调整自动滚屏速度">
                            <ComboBoxItem Content="极慢" Tag="14" />
                            <ComboBoxItem Content="慢速" Tag="24" />
                            <ComboBoxItem Content="中速" Tag="38" />
                            <ComboBoxItem Content="较快" Tag="54" />
                            <ComboBoxItem Content="快速" Tag="74" />
                        </ComboBox>

                        <Border Width="1" Height="14" Background="#CBD5E1" Margin="0,0,8,0" />

                        <!-- Practice: Metronome -->
                        <ToggleButton x:Name="MetronomeToggle" Content="{Binding Practice.MetronomeButtonText}" Padding="7,2" FontSize="11" Margin="0,0,4,0"
                                      Checked="MetronomeToggle_Changed" Unchecked="MetronomeToggle_Changed"
                                      ToolTip="开启/关闭内置节拍器（自动使用谱头 BPM，未填时默认 80 BPM）" />
                        <Button x:Name="MetronomeMeterButton" Content="{Binding Practice.MetronomeMeterLabel}" Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                Click="MetronomeMeter_Click" ToolTip="点击切换节拍器拍号（4/4 / 3/4 / 6/8）" />
                        <TextBlock x:Name="MetronomeBeatText" Text="{Binding Practice.MetronomeBeatText}" FontSize="11" FontWeight="Bold" Foreground="#2F6B48"
                                   VerticalAlignment="Center" MinWidth="28" Margin="0,0,8,0" />

                        <Border Width="1" Height="14" Background="#CBD5E1" Margin="0,0,8,0" />

                        <!-- Zoom -->
                        <Button Content="-" Padding="7,1" FontSize="12" Margin="0,0,4,0" Click="ZoomOut_Click" ToolTip="缩小谱面 (Ctrl + 滚轮向下)" />
                        <TextBlock x:Name="ZoomPercentText" Text="{Binding Practice.ZoomPercentText}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" MinWidth="54" TextAlignment="Center" />
                        <Button Content="+" Padding="7,1" FontSize="12" Margin="4,0,6,0" Click="ZoomIn_Click" ToolTip="放大谱面 (Ctrl + 滚轮向上)" />
                        <Button Content="适应" Padding="7,2" FontSize="11" Click="ZoomFit_Click" ToolTip="自动缩放以完整适应当前窗口宽度" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="{Binding Practice.StatusMessage}"
                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
