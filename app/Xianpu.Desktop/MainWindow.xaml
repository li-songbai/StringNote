<Window x:Class="Xianpu.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Xianpu.Desktop"
        Title="弦笺 · StringNote · 吉他歌词和弦记谱" Height="720" Width="1180"
        MinHeight="500" MinWidth="700" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" Drop="Window_Drop"
        Background="#F3F5F8" FontFamily="Microsoft YaHei UI" Foreground="#1E293B">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2F6B48" />
        <SolidColorBrush x:Key="AccentHover" Color="#245538" />
        <SolidColorBrush x:Key="AccentLight" Color="#EAF3ED" />
        <SolidColorBrush x:Key="BorderBrushStd" Color="#CBD5E1" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2F6B48" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2F6B48" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#245538" />
                    <Setter Property="BorderBrush" Value="#245538" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EAF3ED" />
            <Setter Property="Foreground" Value="#245538" />
            <Setter Property="BorderBrush" Value="#94BFA4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCECE1" />
                    <Setter Property="BorderBrush" Value="#2F6B48" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChordChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,1,4,1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#245538" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>

        <Style x:Key="CaptionControlButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#C50F1F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowOuterBorder" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F3F5F8">
        <Grid x:Name="RootLayoutGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Custom Draggable Window Caption Bar + Minimize / Maximize(Fullscreen) / Exit -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <!-- Right: 3 Caption Control Buttons (Minimize, Fullscreen/Maximize, Exit) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionControlButton}" Click="MinimizeWindow_Click" ToolTip="最小化">
                            <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionControlButton}" Click="ToggleMaximize_Click" ToolTip="全屏 / 最大化">
                            <Path x:Name="MaximizeIconPath" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                        <Button x:Name="ExitButton" Style="{StaticResource CaptionCloseButton}" Click="ExitWindow_Click" ToolTip="退出">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <!-- Left: App Brand + Current Song Title (Draggable Caption Area) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                        <Border Width="20" Height="20" CornerRadius="5" Background="#2F6B48" Margin="0,0,8,0">
                            <TextBlock Text="笺" Foreground="White" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="弦笺 · StringNote" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                        <TextBlock x:Name="CaptionSongTitle" Text="· 吉他歌词和弦记谱" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 1: Responsive Primary Header (4 Metadata Fields + Core Actions, auto-wraps on 13-inch / narrow screens) -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,7">
                <WrapPanel VerticalAlignment="Center">
                    <!-- Library Toggle + 4 Song Metadata Fields -->
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <ToggleButton x:Name="LibraryToggle" Content="曲库 (0)" IsChecked="True"
                                      Margin="0,2,10,2" Padding="9,4" FontSize="12" FontWeight="SemiBold"
                                      Background="#EAF3ED" Foreground="#245538" BorderBrush="#94BFA4" BorderThickness="1" Cursor="Hand"
                                      Checked="LibraryToggle_Changed" Unchecked="LibraryToggle_Changed"
                                      ToolTip="展开或收起左侧本地曲库管理面板" />

                        <!-- 1. 歌曲名称 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                            <TextBlock Text="歌曲" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox x:Name="TitleBox" Width="154" MinWidth="110" TextChanged="SongField_TextChanged" ToolTip="输入歌曲名称" />
                        </StackPanel>

                        <!-- 2. 原调 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                            <TextBlock Text="原调" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="OriginalKeyBox" Width="68" IsEditable="True"
                                      SelectionChanged="OriginalKeyBox_SelectionChanged"
                                      TextBoxBase.TextChanged="OriginalKeyBox_TextChanged"
                                      LostFocus="KeyBox_LostFocus" />
                        </StackPanel>

                        <!-- 3. 选调 + 一键升降调 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                            <TextBlock Text="选调" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="SelectedKeyBox" Width="68" IsEditable="True"
                                      SelectionChanged="SelectedKeyBox_SelectionChanged"
                                      TextBoxBase.TextChanged="SelectedKeyBox_TextChanged"
                                      LostFocus="KeyBox_LostFocus" />
                            <Button Content="♭-1" Padding="6,4" Margin="4,0,2,0" FontSize="11.5" Click="TransposeDown_Click" ToolTip="全谱歌词和弦降半音（不影响前奏/间奏六线谱）" />
                            <Button Content="♯+1" Padding="6,4" Margin="0,0,2,0" FontSize="11.5" Click="TransposeUp_Click" ToolTip="全谱歌词和弦升半音（不影响前奏/间奏六线谱）" />
                            <Button Content="移调" Padding="7,4" FontSize="11.5" Click="TransposeDialog_Click" ToolTip="指定原和弦调与目标调批量转换歌词和弦（不影响前奏/间奏六线谱）" />
                        </StackPanel>

                        <!-- 4. 变调夹 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,4,2">
                            <TextBlock Text="变调夹" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="CapoBox" Width="78" IsEditable="True"
                                      SelectionChanged="CapoBox_SelectionChanged"
                                      TextBoxBase.TextChanged="CapoBox_TextChanged"
                                      LostFocus="KeyBox_LostFocus"
                                      ToolTip="例如：不夹、2 品、4 品" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Action Buttons (Gracefully wraps when narrow, never clips off-screen) -->
                    <WrapPanel VerticalAlignment="Center">
                        <Button Content="导入 LRC" Style="{StaticResource AccentOutlineButton}" Click="ImportLrc_Click" Margin="0,2,5,2" ToolTip="导入 .lrc 或 .txt 歌词文件（也支持直接拖入窗口）" />
                        <Button Content="编辑歌词" Click="EditAllLyrics_Click" Margin="0,2,5,2" ToolTip="粘贴或批量修改整首歌词（保留已有和弦）" />
                        <Button x:Name="PartArrangeButton" Content="段落编排" Click="PartArrange_Click" Margin="0,2,5,2" ToolTip="拆分主歌/副歌段落、合并多遍叠行歌词或折叠重复段" />
                        <Button Content="清空新谱" Click="NewSong_Click" Margin="0,2,8,2" ToolTip="新建空白曲谱" />
                        <Border Width="1" Height="20" Background="#E2E8F0" Margin="0,2,8,2" />
                        <Button Content="导入谱子" Click="OpenProject_Click" Margin="0,2,5,2" ToolTip="导入好友分享的 .xianpu.json 可编辑曲谱文件（也可直接拖入窗口）" />
                        <Button Content="保存" Click="SaveToLibrary_Click" Margin="0,2,5,2" ToolTip="保存到本地曲库" />
                        <Button Content="导出谱子" Click="SaveProject_Click" Margin="0,2,5,2" ToolTip="导出为 .xianpu.json 可编辑曲谱文件，发给好友即可在同款软件中导入继续编辑" />
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Margin="0,2,8,2" ToolTip="检查 GitHub 最新版本" />
                        <Button Content="导出图片 (PNG)" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,2,0,2" Click="ExportPng_Click" ToolTip="将当前曲谱导出为高清 PNG 图片" />
                    </WrapPanel>
                </WrapPanel>
            </Border>

            <!-- Row 2: Secondary Bar (Quick Chords + Layout/Display + Optional Six-Line TAB Control) -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,6">
                <WrapPanel VerticalAlignment="Center">
                    <!-- Left: Common Chords in Current Selected Key + Continuous Paint Mode -->
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <ToggleButton x:Name="ContinuousPaintToggle" Content="✎ 连点填谱" Padding="8,4" Margin="0,2,7,2" FontSize="12"
                                      Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" Cursor="Hand"
                                      Checked="ContinuousPaint_Changed" Unchecked="ContinuousPaint_Changed"
                                      ToolTip="开启后：先点选右侧一个常用和弦，再连续点击歌词上的进唱字位即可批量放置该和弦" />
                        <TextBlock x:Name="PaletteKeyLabel" Text="常用和弦：" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,2,5,2" />
                        <WrapPanel x:Name="QuickChordPanel" VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- Right: Chord & Layout Controls + Optional TAB Component -->
                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="CopyLineChordsButton" Content="复制句和弦" Padding="7,4" FontSize="12" Click="CopyLineChords_Click" IsEnabled="False" Margin="0,2,5,2" ToolTip="复制当前选中句的全部和弦走向（Ctrl+C；Ctrl+D 直接复制到下一句）" />
                        <Button x:Name="PasteLineChordsButton" Content="粘贴句和弦" Padding="7,4" FontSize="12" Click="PasteLineChords_Click" IsEnabled="False" Margin="0,2,5,2" ToolTip="将已复制的和弦走向粘贴到当前选中句（Ctrl+V）" />
                        <Button x:Name="RemoveChordButton" Content="删除选中和弦" Padding="8,4" FontSize="12" Click="RemoveChord_Click" IsEnabled="False" Margin="0,2,5,2" ToolTip="删除当前选中的和弦 (Delete / Backspace)" />
                        <Button Content="清空和弦" Padding="8,4" FontSize="12" Click="ClearAllChords_Click" Margin="0,2,8,2" ToolTip="清除整首歌词上的所有和弦标记（不影响前奏/间奏六线谱）" />
                        <Border Width="1" Height="18" Background="#CBD5E1" Margin="0,2,8,2" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                            <TextBlock Text="排版" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="ColumnModeBox" Width="88" SelectedValuePath="Tag" SelectionChanged="ColumnMode_Changed" ToolTip="合行紧凑：自动将短句并排；逐句单行：每句占一行；双栏对照：左右两栏">
                                <ComboBoxItem Content="合行紧凑" Tag="0" />
                                <ComboBoxItem Content="逐句单行" Tag="1" />
                                <ComboBoxItem Content="双栏对照" Tag="2" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                            <TextBlock Text="标记" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox x:Name="ChordDisplayBox" Width="84" SelectedValuePath="Tag" SelectionChanged="ChordDisplay_Changed" ToolTip="切换歌词上方显示和弦名称、六弦指法图或级数">
                                <ComboBoxItem Content="和弦名称" Tag="name" />
                                <ComboBoxItem Content="指法图" Tag="diagram" />
                                <ComboBoxItem Content="级数" Tag="degree" />
                            </ComboBox>
                        </StackPanel>

                        <Button x:Name="TabSectionButton" Content="+ 六线谱 (可选)" Style="{StaticResource AccentOutlineButton}"
                                Padding="9,4" FontSize="12" Margin="0,2,0,2"
                                Click="TabSectionMenu_Click"
                                ToolTip="添加或管理前奏 / 间奏 / 尾奏六线谱（可选扩展组件，不受变调逻辑影响）" />
                    </WrapPanel>
                </WrapPanel>
            </Border>

            <!-- Row 3: Adjustable Collapsible Song Library Drawer + GridSplitter + Score Canvas -->
            <Grid Grid.Row="3" Background="#E6EBF1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LibraryColumn" Width="236" MinWidth="170" MaxWidth="420" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Collapsible Local Song Library Drawer -->
                <Border x:Name="LibraryDrawer" Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                    <Grid Margin="10,10,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Drawer Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="本地曲库" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                <Border Background="#EAF3ED" CornerRadius="10" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LibraryCountText" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="#245538" />
                                </Border>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ 新建" Padding="6,3" FontSize="11" Margin="0,0,4,0" Click="NewSong_Click" ToolTip="新建空白曲谱并加入曲库" />
                                <Button Content="保存" Padding="6,3" FontSize="11" Margin="0,0,4,0" Style="{StaticResource AccentOutlineButton}" Click="SaveToLibrary_Click" ToolTip="保存当前曲谱到本地曲库" />
                                <Button Content="副本" Padding="6,3" FontSize="11" Click="DuplicateSong_Click" ToolTip="复制当前曲谱为新副本" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Search Box -->
                        <Grid Grid.Row="1" Margin="0,0,0,7">
                            <TextBox x:Name="LibrarySearchBox" Padding="8,4" FontSize="12"
                                     TextChanged="LibraryFilter_Changed"
                                     ToolTip="搜索歌名、调号、分类或歌词..." />
                            <TextBlock x:Name="LibrarySearchPlaceholder" Text="搜索歌名、调号、分类或歌词..."
                                       FontSize="11.5" Foreground="#94A3B8" Margin="10,0,8,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>

                        <!-- Filter Row -->
                        <Grid Grid.Row="2" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LibraryAllFilterButton" Grid.Column="0" Content="全部" Padding="7,3" FontSize="11" Margin="0,0,4,0" Click="LibraryAllFilter_Click" />
                            <Button x:Name="LibraryFavFilterButton" Grid.Column="1" Content="★ 收藏" Padding="7,3" FontSize="11" Margin="0,0,4,0" Click="LibraryFavFilter_Click" />
                            <ComboBox x:Name="LibraryCategoryFilter" Grid.Column="2" FontSize="11" Padding="5,2" SelectionChanged="LibraryFilter_Changed" ToolTip="按分类筛选曲库" />
                            <Button Grid.Column="3" Content="+ 分类" Padding="6,3" FontSize="11" Margin="4,0,0,0" Click="AddCategory_Click" ToolTip="添加新曲库分类" />
                        </Grid>

                        <!-- Active Song Quick Meta -->
                        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="7,5" Margin="0,0,0,7">
                            <DockPanel>
                                <ToggleButton x:Name="SongFavoriteToggle" DockPanel.Dock="Right" Content="☆ 收藏"
                                              Padding="7,2" FontSize="11" Margin="5,0,0,0"
                                              Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" Cursor="Hand"
                                              Checked="SongFavoriteToggle_Changed" Unchecked="SongFavoriteToggle_Changed"
                                              ToolTip="标记或取消收藏当前曲谱" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="分类" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <ComboBox x:Name="SongCategoryBox" Width="102" IsEditable="True" FontSize="11.5" Padding="5,2"
                                              SelectionChanged="SongCategoryBox_SelectionChanged"
                                              LostFocus="SongCategoryBox_LostFocus"
                                              PreviewKeyDown="SongCategoryBox_PreviewKeyDown"
                                              ToolTip="选择或输入当前曲谱分类" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Song List -->
                        <ListBox x:Name="LibrarySongList" Grid.Row="4"
                                 BorderBrush="#E2E8F0" BorderThickness="1" Background="#FFFFFF"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LibrarySongList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="7,6" />
                                    <Setter Property="Margin" Value="2,1" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#F1F5F9" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock DockPanel.Dock="Right" Text="★" FontSize="11.5" Foreground="#D97706" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <DockPanel Grid.Row="1" Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}" FontSize="10" Foreground="#94A3B8" Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding ListSummary}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Bottom Action Bar -->
                        <UniformGrid Grid.Row="5" Columns="4" Margin="0,7,0,0">
                            <Button x:Name="ListFavoriteButton" Content="★ 收藏" Padding="3,4" FontSize="11" Margin="0,0,3,0" Click="ToggleSelectedFavorite_Click" ToolTip="切换当前曲谱收藏状态" />
                            <Button Content="重命名" Padding="3,4" FontSize="11" Margin="0,0,3,0" Click="RenameSong_Click" ToolTip="重命名当前曲谱" />
                            <Button Content="改词" Padding="3,4" FontSize="11" Margin="0,0,3,0" Click="EditAllLyrics_Click" ToolTip="批量编辑当前曲谱歌词" />
                            <Button Content="删除" Padding="3,4" FontSize="11" Foreground="#B91C1C" BorderBrush="#FECACA" Background="#FEF2F2" Click="DeleteSong_Click" ToolTip="从本地曲库删除当前曲谱" />
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Resizable Splitter -->
                <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                              Background="#E2E8F0"
                              ToolTip="左右拖拽调整曲库与谱面宽度" />

                <!-- Score Viewport (Supports blank-area hand-panning & Ctrl+Wheel zoom) -->
                <ScrollViewer x:Name="ScoreScrollViewer" Grid.Column="2"
                              SizeChanged="ScoreViewport_SizeChanged"
                              PreviewMouseWheel="ScoreScrollViewer_PreviewMouseWheel"
                              PreviewMouseDown="ScoreScrollViewer_PreviewMouseDown"
                              PreviewMouseMove="ScoreScrollViewer_PreviewMouseMove"
                              PreviewMouseUp="ScoreScrollViewer_PreviewMouseUp"
                              LostMouseCapture="ScoreScrollViewer_LostMouseCapture"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Background="Transparent" Padding="14">
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"
                            Margin="4" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.08" Color="#0F172A" />
                        </Border.Effect>
                        <local:ScoreSurface x:Name="ScoreSurface" />
                    </Border>
                </ScrollViewer>

                <!-- Inline Chord Input & Quick-Pick Popover (Anchored directly above the clicked lyric character) -->
                <Popup x:Name="ChordPopover" Grid.Column="2" PlacementTarget="{Binding ElementName=ScoreSurface}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       Closed="ChordPopover_Closed">
                    <Border Background="#FFFFFF" BorderBrush="#2F6B48" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Margin="10" Width="408">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" Color="#0F172A" />
                        </Border.Effect>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border Background="#EAF3ED" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="PopoverTargetLabel" Text="进唱字位和弦" FontSize="11.5" FontWeight="SemiBold" Foreground="#2F6B48" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="Enter 确定 · Tab 下一字" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,0,0,8">
                                <ScrollViewer x:Name="PopoverCharStripScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PopoverCharStrip" Orientation="Horizontal" />
                                </ScrollViewer>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="位置：" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="PosOnCharRadio" Content="在字上" GroupName="ChordPosGroup" IsChecked="True"
                                                     FontSize="11.5" VerticalAlignment="Center" Padding="6,2" Margin="0,0,4,0" Cursor="Hand"
                                                     Checked="PopoverPosition_Changed" />
                                        <RadioButton x:Name="PosBeforeCharRadio" Content="在字前" GroupName="ChordPosGroup"
                                                     FontSize="11.5" VerticalAlignment="Center" Padding="6,2" Cursor="Hand"
                                                     Checked="PopoverPosition_Changed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InlineChordBox" Grid.Column="0" FontSize="14" FontWeight="Bold" Padding="9,5"
                                         PreviewKeyDown="InlineChordBox_PreviewKeyDown"
                                         ToolTip="直接输入任意左手和弦名称，例如 C、Am7、Fmaj7、G/B、Bm7-5、Cadd9" />
                                <Button Grid.Column="1" Content="确定" Style="{StaticResource PrimaryButton}" Padding="11,5" Margin="6,0,0,0" Click="CommitInlineChord_Click" />
                                <Button x:Name="DeleteInlineChordButton" Grid.Column="2" Content="删除" Padding="9,5" Margin="5,0,0,0" Foreground="#B91C1C" BorderBrush="#FECACA" Background="#FEF2F2" Click="DeleteInlineChord_Click" />
                            </Grid>
                            <TextBlock Text="本调常用和弦（单击直接填入）：" FontSize="10.5" Foreground="#64748B" Margin="0,0,0,5" />
                            <WrapPanel x:Name="PopoverChordWrap" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Row 4: Compact Bottom Status & Zoom Bar -->
            <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,4">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="谱面缩放" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button Content="-" Padding="7,1" FontSize="12" Margin="0,0,4,0" Click="ZoomOut_Click" ToolTip="缩小谱面 (Ctrl + 滚轮向下)" />
                        <TextBlock x:Name="ZoomPercentText" Text="适应" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" MinWidth="56" TextAlignment="Center" />
                        <Button Content="+" Padding="7,1" FontSize="12" Margin="4,0,6,0" Click="ZoomIn_Click" ToolTip="放大谱面 (Ctrl + 滚轮向上)" />
                        <Button Content="适应窗口" Padding="7,1" FontSize="11" Click="ZoomFit_Click" ToolTip="自动缩放以完整适应当前窗口宽度" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="提示：点击歌词「进唱字位」输入和弦；空白处拖拽可移动页面；顶部可拖动窗口，右下可调整大小。"
                               FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
